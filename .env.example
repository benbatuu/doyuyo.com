# Local Postgres from docker-compose.yml (port 5433 to avoid clashing with a local 5432)
DATABASE_URL=postgres://doyuyo:doyuyo@localhost:5433/doyuyo
NEXT_PUBLIC_SITE_URL=https://doyuyo.com

# Admin panel (apps/admin). Temporary single-account login until user accounts (Argon2 + 2FA) land.
ADMIN_EMAIL=admin@doyuyo.local
ADMIN_PASSWORD=change-me
ADMIN_SESSION_SECRET=replace-with-32+-random-characters

# Public site address. Canonical, sitemap and hreflang use it. Only doyuyo.com is indexable; any other host is noindex.
INDEXNOW_KEY=fdd6b9bc54095a3396580dc05d789062

# ---- Live site (all optional unless marked required) ----
# Search engine verification (the value of the meta tag Google / Bing / Yandex give you)
GOOGLE_SITE_VERIFICATION=
BING_SITE_VERIFICATION=
YANDEX_SITE_VERIFICATION=
# Analytics: loaded only after the visitor accepts cookies
NEXT_PUBLIC_GA_ID=
# Form notifications by e-mail (Resend). Without these, forms still land in the admin inbox.
RESEND_API_KEY=
FORM_NOTIFY_TO=
FORM_NOTIFY_FROM=Doyuyo Form <forms@doyuyo.com>
# Link to the admin panel used inside the notification e-mail
ADMIN_PUBLIC_URL=https://admin.doyuyo.com
# Cloudflare Turnstile (spam protection on forms). Both keys or neither.
NEXT_PUBLIC_TURNSTILE_SITE_KEY=
TURNSTILE_SECRET_KEY=
# First-time content load on a non-local database must be confirmed: SEED_CONFIRM=yes pnpm db:seed
SEED_CONFIRM=
