{
  "name": "@doyuyo/infrastructure",
  "private": true,
  "type": "module",
  "exports": {
    ".": "./src/index.ts"
  },
  "scripts": {
    "typecheck": "tsc --noEmit",
    "db:push": "drizzle-kit push --config drizzle.config.ts",
    "db:generate": "drizzle-kit generate --config drizzle.config.ts",
    "db:migrate": "tsx src/db/migrate.ts",
    "db:seed": "tsx --env-file=../../.env src/db/seed/index.ts",
    "db:seed:demo": "tsx --env-file=../../.env src/db/seed/demo-submissions.ts"
  },
  "dependencies": {
    "@doyuyo/core": "workspace:*",
    "@doyuyo/i18n": "workspace:*",
    "drizzle-orm": "^0.45.4",
    "postgres": "^4.1.1"
  },
  "devDependencies": {
    "@types/node": "^26.6.6",
    "drizzle-kit": "^0.31.11",
    "tsx": "^4.23.15"
  }
}
